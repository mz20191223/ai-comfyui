DETAIL_FIELDS = {
    "camera_shot", "angle", "movement", "subject_position", "camera_note", "duration_sec",
    "duration_note", "gen_mode", "api_style", "resolution", "override_ratio", "seed",
    "summary", "action_beats", "hard_constraints", "mood_tags", "vfx_note", "audio_note",
    "post_audio_note", "video_prompt", "video_prompt_prefix", "image_prompt", "image_negative",
    "image_target_name", "image_refs_note", "image_is_optional", "video_template_id", "image_template_id",
}
SHOT_FIELDS = {"shot_code", "title", "sort_order", "script_excerpt", "notes",
               "thumbnail_path", "final_video_path", "skip_extraction"}


@router.get("/episodes/{episode_id}/shots")
def list_shots(episode_id: int) -> list[dict]:
