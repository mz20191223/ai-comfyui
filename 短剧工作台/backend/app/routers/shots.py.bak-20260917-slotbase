@router.get("/shots/{shot_id}")
def get_shot(shot_id: int) -> dict:
    b = shot_service.get_shot(shot_id)
    if not b:
        raise HTTPException(404, "镜头不存在")
    d = b["detail"]
    if isinstance(d.get("action_beats"), str):
        d["beats"] = jloads(d["action_beats"], [])
    if isinstance(d.get("hard_constraints"), str):
        d["constraints"] = jloads(d["hard_constraints"], [])
    if isinstance(d.get("mood_tags"), str):
        d["moods"] = jloads(d["mood_tags"], [])
    return b


class ShotPatch(BaseModel):
    shot: dict | None = None
    detail: dict | None = None
    note: str | None = None


def _snapshot(shot_id: int, kind: str, content: str | None, note: str | None) -> None:
    if not content:
        return
    last = db.query_one(
        "SELECT content FROM prompt_revisions WHERE target_kind=? AND target_id=? ORDER BY id DESC LIMIT 1",
        (kind, shot_id),
    )
    if last and last["content"] == content:
        return
    db.execute(
        "INSERT INTO prompt_revisions(target_kind, target_id, content, note, source) VALUES(?,?,?,?,?)",
        (kind, shot_id, content, note or "手动编辑", "manual"),
    )


@router.patch("/shots/{shot_id}")
def patch_shot(shot_id: int, body: ShotPatch) -> dict:
    s = db.query_one("SELECT * FROM shots WHERE id=?", (shot_id,))
    if not s:
        raise HTTPException(404, "镜头不存在")

    if body.shot:
        vals = {k: v for k, v in body.shot.items() if k in SHOT_FIELDS}
        if vals:
            cols = ", ".join(f"{k}=?" for k in vals)
            db.execute(
                f"UPDATE shots SET {cols}, updated_at=datetime('now','localtime') WHERE id=?",
                list(vals.values()) + [shot_id],
            )

    if body.detail:
        vals = {}
        for k, v in body.detail.items():
            if k not in DETAIL_FIELDS:
                continue
            vals[k] = jdumps(v) if k in ("action_beats", "hard_constraints", "mood_tags") and not isinstance(v, str) else v
        if vals:
            exists = db.query_one("SELECT shot_id FROM shot_details WHERE shot_id=?", (shot_id,))
            if exists:
                cols = ", ".join(f"{k}=?" for k in vals)
                db.execute(
                    f"UPDATE shot_details SET {cols}, updated_at=datetime('now','localtime') WHERE shot_id=?",
                    list(vals.values()) + [shot_id],
                )
            else:
                cols = ", ".join(vals.keys())
                ph = ", ".join("?" for _ in vals)
                db.execute(
                    f"INSERT INTO shot_details(shot_id, {cols}) VALUES(?, {ph})",
                    [shot_id] + list(vals.values()),
                )
            if "video_prompt" in vals:
                _snapshot(shot_id, "shot_video", vals["video_prompt"], body.note)
            if "image_prompt" in vals:
                _snapshot(shot_id, "shot_image", vals["image_prompt"], body.note)
    return get_shot(shot_id)


