# ---------------- 镜头设置向导 → 提示词注入 ----------------

class WizardIn(BaseModel):
    camera_shot: str | None = None
    angle: str | None = None
    movement: str | None = None
    subject_position: str | None = None


@router.get("/shots/{shot_id}/wizard-note")
def wizard_note(shot_id: int, camera_shot: str = "", angle: str = "",
                movement: str = "", subject_position: str = "") -> dict:
    """只算不写：返回将要注入两份提示词的句子（措辞的唯一事实源在 wizard_service）。"""
    return {
        "image_note": wizard_service.compose_image_note(camera_shot, angle, subject_position),
        "video_note": wizard_service.compose_video_note(angle, movement),
    }


@router.post("/shots/{shot_id}/apply-wizard")
def apply_wizard(shot_id: int, body: WizardIn) -> dict:
    """把向导四步写入镜头字段，并自动注入分镜图/视频提示词。

    注入是「可重复执行」的：靠 wiz_image_note / wiz_video_note 记的上次原文做替换，
    不会每点一次就往后堆一遍。
    """
    if not db.query_one("SELECT id FROM shots WHERE id=?", (shot_id,)):
        raise HTTPException(404, "镜头不存在")
    if not body.camera_shot and not body.angle:
        raise HTTPException(400, "至少选一个景别或视角")

    before = db.query_one(
        "SELECT image_prompt, video_prompt FROM shot_details WHERE shot_id=?", (shot_id,)) or {}
    result = wizard_service.apply_to_shot(
        shot_id,
        camera_shot=body.camera_shot,
        angle=body.angle,
        movement=body.movement,
        subject_position=body.subject_position,
    )
    # 提示词改动留痕，方便回滚
    for kind, key in (("shot_image", "image"), ("shot_video", "video")):
        col = f"{key}_prompt"
        if (before.get(col) or "") != (result[key]["prompt"] or ""):
            _snapshot(shot_id, kind, result[key]["prompt"], "镜头设置向导注入")
    return {"ok": True, **result}


@router.get("/shots/{shot_id}/suggest-tail")
def suggest_tail(shot_id: int) -> dict:
    """建议的尾帧/分镜图文件名（按命名规律推导）。"""
    s = db.query_one("SELECT * FROM shots WHERE id=?", (shot_id,))
    if not s:
        raise HTTPException(404, "镜头不存在")
    ep = db.query_one("SELECT * FROM episodes WHERE id=?", (s["episode_id"],))
    ep_num = ep["number"] if ep else 1
    p = db.query_one("SELECT * FROM projects WHERE id=?", (ep["project_id"],)) if ep else None
    names = naming.keyframe_names(s["shot_code"], ep_num)
    tails = naming.tail_names(s["shot_code"], ep_num)
    return {
        "keyframe_candidates": [
            {"name": n, "exists": bool(file_store.resolve(n, p))} for n in names
        ],
        "tail_candidates": [{"name": n, "exists": bool(file_store.resolve(n, p))} for n in tails],
    }
