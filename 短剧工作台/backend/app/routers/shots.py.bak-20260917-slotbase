def _project_id_of_shot(shot_id: int) -> int | None:
    """镜头 → 集 → 项目。跨项目护栏要用。"""
    row = db.query_one(
        "SELECT e.project_id FROM shots s JOIN episodes e ON e.id=s.episode_id WHERE s.id=?",
        (shot_id,),
    )
    return row["project_id"] if row else None


class RefSlotIn(BaseModel):
    target_side: str = "video"          # video / image
    slot_index: int | None = None
    file_name: str | None = None
    asset_id: int | None = None
    asset_image_id: int | None = None
    role: str | None = None
    take_note: str | None = None
    ref_version: str | None = None


@router.post("/shots/{shot_id}/refs")
def upsert_ref(shot_id: int, body: RefSlotIn) -> dict:
    shot = db.query_one("SELECT * FROM shots WHERE id=?", (shot_id,))
    if not shot:
        raise HTTPException(404, "镜头不存在")
    fname = body.file_name
    image_id = body.asset_image_id
    asset_id = body.asset_id
    if image_id and not fname:
        ai = db.query_one("SELECT * FROM asset_images WHERE id=?", (image_id,))
        if ai:
            fname = ai["file_name"]
            asset_id = asset_id or ai["asset_id"]
    if not fname:
        raise HTTPException(400, "需要 file_name 或 asset_image_id")

    # 跨项目护栏：镜头只能引用「同项目」的资产，避免多项目时把别人的角色/场景挂进来
    proj_id = _project_id_of_shot(shot_id)
    if asset_id:
        a = db.query_one("SELECT project_id, name FROM assets WHERE id=?", (asset_id,))
        if not a:
            raise HTTPException(404, "资产不存在")
        if proj_id and a["project_id"] != proj_id:
            raise HTTPException(
                400, f"资产「{a['name']}」属于其他项目（#{a['project_id']}），不能挂到本项目镜头里"
            )

    idx = body.slot_index
    if idx is None:
        row = db.query_one(
            "SELECT COALESCE(MAX(slot_index), -1) + 1 AS n FROM shot_asset_links "
            "WHERE shot_id=? AND target_side=?",
            (shot_id, body.target_side),
        )
        idx = row["n"]
    exists = db.query_one(
        "SELECT id FROM shot_asset_links WHERE shot_id=? AND target_side=? AND slot_index=?",
        (shot_id, body.target_side, idx),
    )
    if exists:
        db.execute(
            """UPDATE shot_asset_links SET file_name=?, asset_id=?, asset_image_id=?, role=?, take_note=?,
                   ref_version=?, raw_text=? WHERE id=?""",
            (fname, asset_id, image_id, body.role, body.take_note, body.ref_version, body.take_note, exists["id"]),
        )
    else:
        db.execute(
            """INSERT INTO shot_asset_links(shot_id, asset_id, asset_image_id, role, slot_index,
                   target_side, ref_version, take_note, file_name, raw_text)
               VALUES(?,?,?,?,?,?,?,?,?,?)""",
            (shot_id, asset_id, image_id, body.role, idx, body.target_side,
             body.ref_version, body.take_note, fname, body.take_note),
        )
    return get_shot(shot_id)


@router.delete("/shots/{shot_id}/refs/{link_id}")
def delete_ref(shot_id: int, link_id: int) -> dict:
    db.execute("DELETE FROM shot_asset_links WHERE id=? AND shot_id=?", (link_id, shot_id))
    return get_shot(shot_id)


@router.post("/shots/{shot_id}/refs/reorder")
def reorder_refs(shot_id: int, body: dict) -> dict:
    side = body.get("target_side", "video")
    order: list[int] = body.get("link_ids") or []
    for i, lid in enumerate(order):
        db.execute(
            "UPDATE shot_asset_links SET slot_index=? WHERE id=? AND shot_id=? AND target_side=?",
            (i, lid, shot_id, side),
        )
    return get_shot(shot_id)


