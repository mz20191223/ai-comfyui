class ShotAudioIn(BaseModel):
    file_name: str
    line_id: int | None = None
    role_name: str | None = None


def _shot_project(shot_id: int) -> dict | None:
    shot = db.query_one("SELECT * FROM shots WHERE id=?", (shot_id,))
    if not shot:
        return None
    ep = db.query_one("SELECT * FROM episodes WHERE id=?", (shot["episode_id"],))
    if not ep:
        return None
    return db.query_one("SELECT * FROM projects WHERE id=?", (ep["project_id"],))


@router.post("/shots/{shot_id}/audio")
def set_shot_audio(shot_id: int, body: ShotAudioIn) -> dict:
    """挂上本镜的音频素材（配音在外部生成，工作台只登记 + mutagen 精测时长）。

    挂好后该文件即作为 ref_audio_0 随视频请求交给模型，工作台不生成语音。
    """
    project = _shot_project(shot_id)
    if not project:
        raise HTTPException(404, "镜头不存在")
    name = Path(body.file_name).name
    real = file_store.resolve(body.file_name, project)
    if not real:
        raise HTTPException(404, f"音频文件找不到：{body.file_name}")

    measured = file_store.audio_duration(real)
    line = None
    if body.line_id:
        line = db.query_one(
            "SELECT * FROM shot_dialog_lines WHERE id=? AND shot_id=?", (body.line_id, shot_id)
        )
    if not line:
        line = db.query_one(
            "SELECT * FROM shot_dialog_lines WHERE shot_id=? ORDER BY line_index, id LIMIT 1", (shot_id,)
        )
    if line:
        db.execute(
            "UPDATE shot_dialog_lines SET audio_file=?, audio_measured_sec=?, "
            "role_name=COALESCE(?, role_name) WHERE id=?",
            (name, measured, body.role_name, line["id"]),
        )
    else:
        db.execute(
            "INSERT INTO shot_dialog_lines(shot_id, line_index, role_name, audio_file, audio_measured_sec) "
            "VALUES(?,?,?,?,?)",
            (shot_id, 1, body.role_name, name, measured),
        )
    return {
        "ok": True, "file_name": name, "path": str(real), "measured_sec": measured,
        "audit": hooks_service.audit_audio(shot_id), "shot": get_shot(shot_id),
    }


@router.delete("/shots/{shot_id}/audio")
def clear_shot_audio(shot_id: int, line_id: int | None = None) -> dict:
    """摘掉音频素材：给 line_id 只摘那一行台词，不给则摘掉整镜（全部台词行）。

    一个镜头可以挂多段音频（分句台词各挂一段，依次作为 ref_audio_0/1/... 交给模型），
    所以按行摘是常态操作。
    """
    if line_id:
        db.execute(
            "UPDATE shot_dialog_lines SET audio_file=NULL, audio_measured_sec=NULL "
            "WHERE id=? AND shot_id=?", (line_id, shot_id)
        )
    else:
        db.execute(
            "UPDATE shot_dialog_lines SET audio_file=NULL, audio_measured_sec=NULL WHERE shot_id=?", (shot_id,)
        )
    return {"ok": True, "shot": get_shot(shot_id)}


