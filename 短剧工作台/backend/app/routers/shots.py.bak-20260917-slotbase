# ---------------- 生成 ----------------

class GenerateIn(BaseModel):
    kind: str                       # image / video
    model_id: int | None = None
    overrides: dict | None = None
    force: bool = False
    auto_tail: bool = True
    skip_lint: bool = False


@router.post("/shots/{shot_id}/generate")
def generate(shot_id: int, body: GenerateIn) -> dict:
    shot = db.query_one("SELECT * FROM shots WHERE id=?", (shot_id,))
    if not shot:
        raise HTTPException(404, "镜头不存在")
    overrides = body.overrides or {}

    if body.kind == "video":
        params = task_runner.build_video_params(shot_id, overrides)
        params["force"] = body.force
        params["auto_tail"] = body.auto_tail
        params["model_id"] = body.model_id
        prompt = params.get("prompt") or ""
        if not prompt.strip():
            raise HTTPException(400, "本镜没有视频提示词，无法生成")
        if not params.get("ref_images") and not params.get("first_frame"):
            pass  # 纯文生也允许
        tid = task_runner.create_task(
            "video_generation", target_kind="shot", target_id=shot_id, role="video",
            payload=params, model_id=body.model_id,
        )
    elif body.kind == "image":
        params = task_runner.build_image_params(shot_id, overrides)
        params["model_id"] = body.model_id
        if not (params.get("prompt") or "").strip():
            raise HTTPException(400, "本镜没有分镜图提示词，无法生成")
        tid = task_runner.create_task(
            "image_generation", target_kind="shot", target_id=shot_id, role="keyframe",
            payload=params, model_id=body.model_id,
        )
    elif body.kind == "tts":
        raise HTTPException(
            400,
            "工作台不做配音生成：音频请在镜头里「选择音频文件」直接挂上，随 ref_audio_* 交给视频模型",
        )
    else:
        raise HTTPException(400, f"未知生成类型：{body.kind}")
    return {"ok": True, "task_id": tid}


class DryRunIn(BaseModel):
    kind: str = "video"
    model_id: int | None = None
    overrides: dict | None = None


@router.post("/shots/{shot_id}/dry-run")
def dry_run(shot_id: int, body: DryRunIn) -> dict:
    from ..executors import provider_engine as PE

    try:
        bundle = PE.load_model_bundle(body.model_id, body.kind)
    except PE.ProviderError as e:
        raise HTTPException(400, str(e)) from e
    if body.kind == "video":
        params = task_runner.build_video_params(shot_id, body.overrides or {})
    elif body.kind == "image":
        params = task_runner.build_image_params(shot_id, body.overrides or {})
    else:
        raise HTTPException(400, f"未知生成类型：{body.kind}")
    try:
        res = PE.execute(bundle, params, dry_run=True)
    except PE.ProviderError as e:
        raise HTTPException(400, str(e)) from e
    return {"ok": True, "preview": res.request_preview, "params": {k: v for k, v in params.items() if k != "prompt"},
            "prompt_len": len(params.get("prompt") or "")}


# ---------------- 增删镜头 ----------------

class NewShotIn(BaseModel):
    shot_code: str
    title: str | None = None
    after_shot_id: int | None = None
    duration_sec: float | None = None


@router.post("/episodes/{episode_id}/shots")
def create_shot(episode_id: int, body: NewShotIn) -> dict:
    ep = db.query_one("SELECT * FROM episodes WHERE id=?", (episode_id,))
    if not ep:
        raise HTTPException(404, "集不存在")
    mx = db.query_one("SELECT COALESCE(MAX(sort_order), -1) AS m FROM shots WHERE episode_id=?", (episode_id,))["m"]
    order = mx + 1
    if body.after_shot_id:
        a = db.query_one("SELECT * FROM shots WHERE id=?", (body.after_shot_id,))
        if a:
            order = (a["sort_order"] or 0) + 1
            db.execute(
                "UPDATE shots SET sort_order = sort_order + 1 WHERE episode_id=? AND sort_order >= ?",
                (episode_id, order),
            )
    sid = db.execute(
        "INSERT INTO shots(episode_id, shot_code, title, sort_order) VALUES(?,?,?,?)",
        (episode_id, body.shot_code, body.title, order),
    )
    db.execute(
        "INSERT INTO shot_details(shot_id, duration_sec) VALUES(?,?)", (sid, body.duration_sec)
    )
    return get_shot(sid)


@router.delete("/shots/{shot_id}")
def delete_shot(shot_id: int) -> dict:
    db.execute("DELETE FROM shots WHERE id=?", (shot_id,))
    return {"ok": True}


@router.post("/episodes/{episode_id}/shots/reorder")
def reorder_shots(episode_id: int, body: dict) -> dict:
    ids: list[int] = body.get("shot_ids") or []
    for i, sid in enumerate(ids):
        db.execute("UPDATE shots SET sort_order=? WHERE id=? AND episode_id=?", (i, sid, episode_id))
    return {"ok": True}


