# ---------------- 产物归档 / 废弃 ----------------

class DiscardIn(BaseModel):
    path: str


def _move_output(shot_id: int, src_path: str, dest_dir: str | None, fallback_dir,
                 on_conflict: str, label: str) -> Path:
    """把产物从暂存区移到目标目录（磁盘移动，不删除）。同名时加「_归档1 / _废1」后缀。"""
    if not db.query_one("SELECT id FROM shots WHERE id=?", (shot_id,)):
        raise HTTPException(404, "镜头不存在")
    src = Path(src_path)
    if not src.exists():
        raise HTTPException(404, f"文件不存在：{src_path}")

    base = Path(dest_dir) if dest_dir else Path(fallback_dir)
    try:
        base.mkdir(parents=True, exist_ok=True)
    except OSError as e:
        raise HTTPException(500, f"{label}目录创建失败：{e}")

    dest = base / src.name
    k = 1
    while dest.exists():
        dest = base / f"{src.stem}_{on_conflict}{k}{src.suffix}"
        k += 1
    try:
        shutil.move(str(src), str(dest))
    except OSError as e:
        raise HTTPException(500, f"移动失败：{e}")
    return dest


def _remark_output(shot_id: int, old_path: str, dest: Path, flags: dict) -> None:
    """产物换了磁盘位置后，回写任务结果里的 path 与状态位，并同步文件索引。

    界面上的产物列表、选尾帧的成片候选都读 task.result.files，所以必须回写；
    files 表的 path 一起更新，否则「按文件名找素材」会指到旧位置。
    """
    rows = db.query(
        """SELECT t.id, t.result FROM generation_tasks t
           JOIN task_links l ON l.task_id=t.id
           WHERE l.target_kind='shot' AND l.target_id=? AND t.result IS NOT NULL""",
        (shot_id,),
    )
    for r in rows:
        try:
            res = jloads(r["result"], {}) or {}
        except Exception:
            continue
        changed = False
        for f in res.get("files") or []:
            if f.get("path") == old_path:
                f["path"] = str(dest)
                f.update(flags)
                changed = True
        if changed:
            db.execute("UPDATE generation_tasks SET result=? WHERE id=?", (jdumps(res), r["id"]))
    db.execute(
        "UPDATE files SET path=?, file_name=? WHERE path=?",
        (str(dest), dest.name, old_path),
    )


@router.post("/shots/{shot_id}/accept-output")
def accept_output(shot_id: int, body: DiscardIn) -> dict:
    """把暂存区里的产物归档进项目「分镜视频」目录（磁盘移动）。

    归档＝认可这一段，所以顺手把本镜成片指过去（shots.final_video_path）；
    任务结果里标 pending=False / accepted=True，界面不再当「待归档」展示。
    """
    project = _shot_project(shot_id)
    vdir = (project or {}).get("video_dir")
    if not vdir:
        raise HTTPException(400, "项目未配置「分镜视频」目录")
    dest = _move_output(shot_id, body.path, vdir, vdir, "归档", "分镜视频")
    _remark_output(shot_id, body.path, dest, {"pending": False, "accepted": True})
    db.execute("UPDATE shots SET final_video_path=? WHERE id=?", (str(dest), shot_id))
    return {"ok": True, "new_path": str(dest), "shot": get_shot(shot_id)}


@router.post("/shots/{shot_id}/discard-output")
def discard_output(shot_id: int, body: DiscardIn) -> dict:
    """不要的产物移入项目「废弃产物」目录（磁盘移动，不删除）。

    同时在任务结果里把该文件标记 discarded=True，界面不再当有效候选展示；
    若它已登记为本镜首帧/尾帧，一并下架。
    """
    project = _shot_project(shot_id)
    dest = _move_output(shot_id, body.path, (project or {}).get("discard_dir"),
                        DEFAULT_DISCARD_DIR, "废", "废弃")
    _remark_output(shot_id, body.path, dest, {"discarded": True, "pending": False})

    # 已登记为首帧/尾帧的，一并下架
    db.execute(
        "UPDATE shot_frames SET is_active=0 WHERE shot_id=? AND (file_path=? OR file_name=?)",
        (shot_id, body.path, Path(body.path).name),
    )
    return {"ok": True, "new_path": str(dest), "shot": get_shot(shot_id)}


