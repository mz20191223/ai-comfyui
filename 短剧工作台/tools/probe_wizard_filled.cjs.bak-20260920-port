/**
 * 截图确认：回填后镜头详情页的「镜头设置」显示情况。
 * 用法：node tools/probe_wizard_filled.cjs
 */
const PW = 'C:/Users/Administrator/AppData/Roaming/npm/node_modules/@playwright/cli/node_modules/playwright-core'
const { chromium } = require(PW)
const BASE = 'http://127.0.0.1:5180'
const EXE = 'C:/Program Files/Google/Chrome/Application/chrome.exe'
const OUT = 'D:/Aicomfyui/短剧工作台/storage/ui-tour'

const read = () => {
  const el = document.querySelector('.wizard')
  if (!el) return null
  return {
    head: (el.querySelector('.wz-head')?.innerText || '').replace(/\s+/g, ' ').trim(),
    figs: [...el.querySelectorAll('.wz-fig')].map((f) => {
      const img = f.querySelector('img')
      const svg = f.querySelector('svg')
      return {
        cap: (f.querySelector('figcaption')?.innerText || '').trim(),
        src: img ? `${img.src.split('/').pop()} ${img.naturalWidth}x${img.naturalHeight}` : `svg(${svg ? svg.querySelectorAll('path,line,circle,rect').length : 0})`,
      }
    }),
    lines: [...el.querySelectorAll('.wz-line')].map((l) => (l.innerText || '').replace(/\s+/g, ' ').trim()),
  }
}

;(async () => {
  const b = await chromium.launch({ headless: true, executablePath: EXE })
  const ctx = await b.newContext({ viewport: { width: 1680, height: 1100 } })
  const p = await ctx.newPage()
  const errs = []
  p.on('console', (m) => { if (m.type() === 'error') errs.push(m.text().slice(0, 180)) })
  p.on('pageerror', (e) => errs.push('PAGEERROR ' + String(e).slice(0, 180)))

  for (const [sid, label] of [['113', '14c'], ['114', '14d'], ['117', '19'], ['121', '23']]) {
    await p.goto(`${BASE}/#/p/1/shot/${sid}`, { waitUntil: 'load', timeout: 30000 })
    await p.waitForFunction(() => document.body.innerText.includes('首帧锚点'), { timeout: 25000 }).catch(() => {})
    await p.waitForTimeout(1200)
    const collapsed = await p.evaluate(read)
    await p.click('.wz-head')
    await p.waitForTimeout(900)
    const r = await p.evaluate(read)
    console.log(`\n════ 镜号 ${label}（#/p/1/shot/${sid}）`)
    console.log('  折叠标题:', collapsed ? collapsed.head : '!! 缺')
    console.log('  示意图  :', r.figs.map((f) => `${f.cap}[${f.src}]`).join('  '))
    console.log('  注入句  :', r.lines.join('  ｜  '))
    const wz = await p.$('.wizard')
    await wz.screenshot({ path: `${OUT}/wz_filled_${sid}.png` })
  }

  console.log('\n控制台:', errs.length ? errs.map((e) => '  ✕ ' + e).join('\n') : '✓ 零异常')
  await b.close()
})()
