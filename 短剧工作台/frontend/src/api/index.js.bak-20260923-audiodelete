// 媒体地址（用于 img/video src）
export const fileUrl = (path, thumb = 0) =>
  path ? `/api/media/file?path=${encodeURIComponent(path)}` : ''
export const thumbUrl = (path, size = 240) =>
  path ? `/api/media/thumb?path=${encodeURIComponent(path)}&size=${size}` : ''

